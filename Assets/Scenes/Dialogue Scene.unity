  m_Script: {fileID: 11500000, guid: 88a834d29be3fbd4cb9619dcad964db7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialNPC
  interactSprite: {fileID: 1042038434}
  dialogue:
    lines:
    - speakerName: Morrigan
      line: '*Yawn*'
      portrait: {fileID: 21300000, guid: f23b36145c99cb041a109994af1e8af1, type: 3}
    - speakerName: Morrigan
      line: 'It''s only been a decade, whose already calling on me again... '
      portrait: {fileID: 21300000, guid: f23b36145c99cb041a109994af1e8af1, type: 3}
    - speakerName: ???
      line: 'Great Witch Morrigan! A witch like you is too powerful for the powers
        at be. Despite your... contributions, I''m afraid you''re being placed under
        arrest! '
      portrait: {fileID: -3564510160684433930, guid: 8bce688be70513842b1c9ab825bf79df, type: 3}
    - speakerName: ???
      line: 'Come quietly if you know what''s good for you! '
      portrait: {fileID: -3564510160684433930, guid: 8bce688be70513842b1c9ab825bf79df, type: 3}
    - speakerName: Morrigan
      line: ... What a joke...
      portrait: {fileID: 21300000, guid: f23b36145c99cb041a109994af1e8af1, type: 3}
    - speakerName: ???
      line: So be it. Guards!
      portrait: {fileID: -3564510160684433930, guid: 8bce688be70513842b1c9ab825bf79df, type: 3}
  dialogueCon: {fileID: 1598677417}
  isCutscene: 1
